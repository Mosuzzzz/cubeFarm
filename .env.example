POSTGRES_DB=smartfarm
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://smartfarm:change-me@postgres:5432/smartfarm?sslmode=disable
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=smartfarm
MQTT_PASSWORD=change-me
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=

# Optional LINE MINI App (LIFF) access. Set these to require LINE login for every API call.
# The controller also needs a public HTTPS endpoint (for example, an HTTPS
# reverse tunnel to 127.0.0.1:8765) for LINE on a phone to reach this computer.
LIFF_ID=
LINE_CHANNEL_ID=
LIFF_ALLOWED_USER_ID=

# LINE Messaging API push notifications (keep the access token private).
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_USER_ID=


NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_LIFF_ID=
